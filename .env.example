# yourDrive — environment variables
# Copy this file to `.env.local` and fill in the real values.
# `.env.local` is gitignored and must NEVER be committed.

# --- Supabase (public / browser-safe) ---
# Found in your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Supabase (server-only, added in a later module) ---
# The service-role key bypasses Row Level Security. Keep it server-side ONLY.
# Do NOT prefix it with NEXT_PUBLIC_ or it will leak to the browser.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
